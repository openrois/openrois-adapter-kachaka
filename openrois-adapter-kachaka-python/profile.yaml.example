# Kachaka adapter profile.
#
# Copy to profile.yaml and edit the grpc_target to match your robot.

fleet_id: kachaka

connection:
  ws:
    host: "127.0.0.1"
    port: 8765

robot:
  grpc_target: "192.168.100.203:26400"
  auto_homing: false
  poll_interval_sec: 0.5

components:
  - ref: "SystemInformation"
    type: basic
    bind_required: false
    queries: [robot_position, component_status]

  - ref: "Navigation"
    type: basic
    bind_required: true
    commands: [execute, stop]
    queries: [waypoints, component_status]
    events: [reached_target]