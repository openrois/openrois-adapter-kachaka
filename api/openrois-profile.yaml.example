# Kachaka adapter profile.
#
# Copy to openrois-profile.yaml and edit the grpc_server to match your robot.

fleet_id: kachaka

connection:
  ws:
    host: "127.0.0.1"
    port: 8765

robot:
  grpc_server: "192.168.1.100:26400"
  auto_homing: false
  poll_interval_sec: 0.5

map:
  map_name: "org-kachaka@location"
  resolution: 0.025
  origin_x: -2.1557
  origin_y: -7.83943
  width: 447
  height: 514

components:
  - ref: "SystemInformation"
    type: standard
    bind_required: false
    queries: [robot_position, engine_status]

  - ref: "Navigation"
    type: standard
    bind_required: true
    commands: [start, stop, suspend, resume, set_parameter, execute]
    queries: [component_status, get_parameter]
    events: [reached_target]
