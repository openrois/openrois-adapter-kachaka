# Kachaka adapter profile.
#
# Copy to openrois-profile.yaml and edit the grpc_server to match your robot.

engine:
  id: kachaka_01
  platform: kachaka
  gateway_url: "ws://127.0.0.1:8765"

environment:
  grpc_server: "192.168.1.100:26400"
  auto_homing: false

components:
  Navigation:
    poll_interval: 0.5
  SystemInformation: {}
  NavigationInformation:
    map_name: "coarobo-kachaka_01@unicorn"
